# LLM 供应商: deepseek | xiaomi
LLM_PROVIDER=deepseek
OLLAMA_MODEL=qwen3.5:9b

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

XIAOMI_API_KEY=your-xiaomi-api-key
XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2-pro

# Embedding 供应商: deepseek | xiaomi | local | ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_DEEPSEEK_MODEL=deepseek-embedding
EMBEDDING_XIAOMI_MODEL=text-embedding-001
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_OLLAMA_MODEL=nomic-embed-text:v1.5

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
# Chroma 向量库持久化目录
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# 文档分块
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# 检索返回数量
SEARCH_TOP_K=4
